# Copie para .env e preencha. Não commite o .env.

# Banco (docker compose e a aplicação)
postgres_db=geofiber
postgres_username=
postgres_password=
postgres_data=/var/lib/postgresql/data/pgdata
postgres_ports=127.0.0.1:5432:5432

# Autenticação (obrigatório): chave de pelo menos 32 bytes
GEOFIBER_JWT_SECRET=

# Administrador criado na primeira subida, quando não há usuário
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Origem do front permitida no CORS (com cookies)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Swagger/OpenAPI: true só na máquina de desenvolvimento (o npm run api:types do front usa). Em produção, deixe sem.
API_DOCS_ENABLED=true
