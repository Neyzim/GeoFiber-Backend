# Variáveis de PRODUÇÃO do backend (docs/PUBLICAR.md, seção 2).
# Copie para /etc/geofiber/backend.env no servidor:
#   sudo install -o geofiber -g geofiber -m 600 deploy/backend.env.example /etc/geofiber/backend.env
# e preencha. Nunca commite o arquivo preenchido.

# Banco: usuário próprio da aplicação, senha forte (não use "postgres")
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/geofiber
DATABASE_USERNAME=geofiber_app
DATABASE_PASSWORD=

# Chave do JWT: gere com  openssl rand -base64 48  (diferente da do desenvolvimento)
GEOFIBER_JWT_SECRET=

# Endereço público do site (front e API no mesmo domínio)
CORS_ALLOWED_ORIGINS=https://geofiber.seudominio.com.br

# Só o proxy (nginx) fala com o backend; IP real do cliente vem do X-Forwarded-For
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native

# Administrador inicial: só na PRIMEIRA subida. Depois apague ADMIN_PASSWORD e reinicie.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Swagger/OpenAPI: não defina API_DOCS_ENABLED em produção (fica desligado).
